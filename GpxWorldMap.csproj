<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GpxWorldMap</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Config\" />
    <Folder Include="Models\" />
    <Folder Include="Readers\" />
    <Folder Include="Server\" />
    <Folder Include="Shared\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="bin\Debug\net8.0\gpxworldmap.config.json" />
    <None Remove="bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="bin\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Rendering/Templates/*.html" CopyToOutputDirectory="PreserveNewest"/>
<!--
    <EmbeddedResource Include="Rendering/Templates/*.html" />
-->
  </ItemGroup>
  <ItemGroup>
    <Content Include="Controls/Templates/*.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Index/*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
